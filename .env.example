# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to version control and must
# never be reachable by URL (protected by the deny-all .htaccess
# in this directory).

APP_ENV=production

# --- Database ---
DB_PATH=storage/db/router.sqlite

# --- Key management ---
# Directory holding per-app KEK files. Each file should be 0400,
# outside version control.
KEK_STORE_PATH=storage/keys

# --- Google Drive OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Google API URL overrides (optional, testing only) ---
# Leave these unset in production — the app defaults to the real Google
# endpoints. Only set these to point at a fake/mock server for local
# testing without real Google credentials.
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_USERINFO_URL=
# GOOGLE_AUTHORIZE_URL=
# GOOGLE_DRIVE_API_BASE_URL=
# GOOGLE_DRIVE_UPLOAD_BASE_URL=

# --- Admin session ---
ADMIN_SESSION_SECRET=

# --- Audit log retention (days) ---
# OLD audit rows older than this are pruned. Enforced automatically on
# writes (probabilistically) and deterministically via bin/prune-logs.php.
# Default 30 if unset.
# AUDIT_LOG_RETENTION_DAYS=30

# --- Rate limiting ---
# Traffic control is expected at the EDGE (Nginx limit_req / CDN / mod_evasive)
# so the single-writer SQLite DB is never a bottleneck.
# The in-app per-app limiter below is OPT-IN: set >0 only if you have NO
# reverse proxy. 0 (default) = it writes nothing and passes all requests.
RATE_LIMIT_UPLOAD_PER_MINUTE=0
RATE_LIMIT_FILES_PER_MINUTE=0

# --- Upload size cap (bytes) ---
# Maximum allowed plaintext upload size (default 104857600 = 100 MiB).
# Enforced by counting actual bytes read from the body, so a spoofed
# Content-Length can't bypass it. Set 0 to disable the cap (not recommended).
MAX_UPLOAD_BYTES=104857600
