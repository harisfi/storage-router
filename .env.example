# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to version control and must
# never be reachable by URL (protected by the deny-all .htaccess
# in this directory).

APP_ENV=production

# --- Database ---
DB_PATH=storage/db/router.sqlite

# --- Key management ---
# Directory holding per-app KEK files. Each file should be 0400,
# outside version control.
KEK_STORE_PATH=storage/keys

# --- Google Drive OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Google API URL overrides (optional, testing only) ---
# Leave these unset in production — the app defaults to the real Google
# endpoints. Only set these to point at a fake/mock server for local
# testing without real Google credentials.
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_USERINFO_URL=
# GOOGLE_AUTHORIZE_URL=
# GOOGLE_DRIVE_API_BASE_URL=
# GOOGLE_DRIVE_UPLOAD_BASE_URL=

# --- Admin session ---
ADMIN_SESSION_SECRET=

# --- Rate limiting ---
# Requests per app per 60-second window. 0 disables the limit for that endpoint.
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_FILES_PER_MINUTE=120

# --- Upload size cap (bytes) ---
# Maximum allowed plaintext upload size. 0 disables the cap. Enforced both
# from the Content-Length header (before encryption) and from the actual
# encrypted size (so a missing header can't bypass it). e.g. 104857600 = 100 MiB.
MAX_UPLOAD_BYTES=0
